# Copy this to .env and fill in real values from your Supabase project
# (Project Settings > Database for connection strings, > API for keys).
# .env is git-ignored — never commit real secrets.

SUPABASE_URL="https://your-project-ref.supabase.co"

# Pooled (pgbouncer, transaction mode, port 6543) — app runtime.
# Should authenticate as app_user, not postgres, once that role exists —
# see prisma/migrations/*_app_role and CLAUDE.md for why.
DATABASE_URL="postgresql://app_user.your-project-ref:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations only. Always the postgres role; app_user has no DDL privileges.
# This is the Session Pooler (same host as DATABASE_URL, port 5432, no
# pgbouncer=true) — NOT the "Direct connection" host from the dashboard.
# That one (db.<ref>.supabase.co) is IPv6-only since Jan 2024 and will
# fail with P1001 "Can't reach database server" on IPv4-only networks,
# which is most home/ISP connections.
DIRECT_URL="postgresql://postgres.your-project-ref:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Client-safe — Supabase Auth.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-public-key>"

# Server-only. Bypasses RLS entirely — see src/lib/supabase/admin.server.ts.
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"

# Local/CI only — a throwaway Postgres instance, never the real project.
# See scripts/apply-test-schema.ts and tests/tenant-isolation.test.ts.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Meta Lead Ads webhook (issue #24) — app-level, one Meta App per
# deployment. Per-org Page ID + access token live in the
# org_meta_credentials table instead (set via setMetaPageCredentials).
META_APP_SECRET="<meta-app-secret>"
META_WEBHOOK_VERIFY_TOKEN="<any-string-you-choose-and-enter-in-meta-app-dashboard>"
WHATSAPP_APP_SECRET="<meta-app-secret-for-the-whatsapp-app>"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="<any-string-you-choose-and-enter-in-meta-app-dashboard>"

# Nightly ad-spend sync cron (issue #29, docs/specs/10-ad-spend-sync.md).
# Vercel sends "Authorization: Bearer $CRON_SECRET" automatically for its
# own Cron Job invocations once this is set in the project's env vars — any
# string works, it just has to match.
CRON_SECRET="<any-string-you-choose>"
# Printed by `bun run ad-spend:setup-system-user` (run once per environment
# — see scripts/setup-ad-spend-sync-system-user.ts). Not set until that's
# been run.
AD_SPEND_SYNC_SYSTEM_USER_ID="<uuid-printed-by-the-setup-script>"
