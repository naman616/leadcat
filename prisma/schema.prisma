generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer, port 6543) — the app always talks to this
  // one at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — Prisma Migrate uses this one, since
  // migrations need session-level features pgbouncer's transaction mode
  // doesn't support. Never swap these two.
  directUrl = env("DIRECT_URL")
}

/// One row per tenant. Every tenant-scoped table's org_id points here.
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  /// Separate, unguessable, rotatable identifier for the public website
  /// lead-capture form (issue #22) — deliberately NOT id/slug. Embedded in
  /// a public form/script; holding it authorizes an anon INSERT into this
  /// org's contacts/leads only (see the RLS policies added alongside this
  /// column), never read/update/delete. Rotating it (re-running
  /// gen_random_uuid()) is how a leaked token is revoked.
  publicFormToken String @unique @default(dbgenerated("gen_random_uuid()")) @map("public_form_token") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  members          OrgMember[]
  contacts         Contact[]
  leads            Lead[]
  activities       LeadActivity[]
  assignments      LeadAssignment[]
  projects         Project[]
  towers           Tower[]
  units            Unit[]
  tasks            Task[]
  projectMedia     ProjectMedia[]
  unitPriceHistory UnitPriceHistory[]
  callLogs         CallLog[]
  whatsappTemplates WhatsAppTemplate[]
  whatsappMessages  WhatsAppMessage[]

  @@map("organizations")
}

/// Mirrors auth.users (Supabase Auth owns real credentials). id is set to
/// the same value as auth.users.id by a trigger on signup — see the RLS/
/// setup migration, not a Prisma-managed relation, since auth.users lives
/// outside Prisma's schema.
model User {
  id        String   @id @db.Uuid
  email     String
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")

  memberships         OrgMember[]
  assignedLeads       Lead[]           @relation("LeadAssignedTo")
  authoredActivities  LeadActivity[]
  assignmentsReceived LeadAssignment[] @relation("AssignmentAssignedTo")
  assignmentsMade     LeadAssignment[] @relation("AssignmentAssignedBy")
  assignedTasks       Task[]           @relation("TaskAssignedTo")
  createdTasks        Task[]           @relation("TaskCreatedBy")
  uploadedMedia       ProjectMedia[]
  unitPriceChanges    UnitPriceHistory[]
  initiatedCalls      CallLog[]

  @@map("users")
}

enum OrgRole {
  owner
  admin
  agent
  cp_admin
  cp_agent

  @@map("org_role")
}

/// Which orgs a user belongs to, and with what role. A user can belong to
/// more than one org (e.g. a channel-partner agent working two developers),
/// so this is its own table rather than a column on User.
model OrgMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

enum LeadStatus {
  New
  FollowUp  @map("Follow Up")
  Callback
  SiteVisit @map("Site Visit")
  Booked
  Dropped

  @@map("lead_status")
}

enum ActivityType {
  note
  status_change
  call
  whatsapp
  email
  system

  @@map("activity_type")
}

/// A person, distinct from a lead — one person can be three leads across
/// three projects/sources. Merging these is "the #1 CRM schema regret"
/// per the build plan; keep them separate from day one.
model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  fullName  String   @map("full_name")
  phone     String?
  email     String?
  city      String?
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@map("contacts")
}

/// The enquiry itself. Attribution columns (source_id..captured_at) are
/// nullable and unpopulated in this slice — the ad hierarchy tables behind
/// them are Phase 3. Adding the columns now, empty, is cheap; retrofitting
/// them onto a live leads table with real data later is not (§3.5.2).
model Lead {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  contactId    String     @map("contact_id") @db.Uuid
  assignedTo   String?    @map("assigned_to") @db.Uuid
  status       LeadStatus @default(New)
  subStatus    String?    @map("sub_status")
  source       String?
  subSource    String?    @map("sub_source")
  project      String?
  budget       String?
  requirement  String?
  city         String?
  nextActionAt DateTime?  @map("next_action_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  // Attribution — §3.5.2, all nullable, unpopulated until Phase 3.
  sourceId       String?   @map("source_id") @db.Uuid
  adId           String?   @map("ad_id") @db.Uuid
  adSetId        String?   @map("ad_set_id") @db.Uuid
  campaignId     String?   @map("campaign_id") @db.Uuid
  creativeId     String?   @map("creative_id")
  formId         String?   @map("form_id")
  platformLeadId String?   @map("platform_lead_id")
  clickId        String?   @map("click_id")
  utmSource      String?   @map("utm_source")
  utmMedium      String?   @map("utm_medium")
  utmCampaign    String?   @map("utm_campaign")
  utmContent     String?   @map("utm_content")
  utmTerm        String?   @map("utm_term")
  landingPageUrl String?   @map("landing_page_url")
  referrerUrl    String?   @map("referrer_url")
  firstTouchAdId String?   @map("first_touch_ad_id") @db.Uuid
  rawPayload     Json?     @map("raw_payload")
  capturedAt     DateTime? @map("captured_at")

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee     User?            @relation("LeadAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  activities   LeadActivity[]
  assignments  LeadAssignment[]
  tasks        Task[]
  callLogs     CallLog[]
  whatsappMessages WhatsAppMessage[]

  @@map("leads")
}

/// The timeline. One table across activity types rather than one per type,
/// matching the existing UI's "History" tab.
model LeadActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  leadId    String       @map("lead_id") @db.Uuid
  type      ActivityType
  body      String
  createdBy String?      @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("lead_activities")
}

/// History, not a column — "who had this lead in March" needs to be
/// answerable in a brokerage dispute, per the build plan.
model LeadAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  assignedTo String   @map("assigned_to") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee       User         @relation("AssignmentAssignedTo", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedByUser User?        @relation("AssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@map("lead_assignments")
}

enum ProjectType {
  Residential
  Commercial
  Agricultural

  @@map("project_type")
}

enum UnitStatus {
  Available
  Blocked
  Booked
  Registered

  @@map("unit_status")
}

/// A developer/builder project. See docs/specs/02-inventory.md — no
/// separate `developers` entity yet; `Organization` is the tenant boundary
/// and there's no current product need to model multiple developers under
/// one org. starting_price / unit_config_summary are display-only free
/// text (matches the pre-existing mock UI), not derived from real units.
model Project {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String      @map("org_id") @db.Uuid
  name              String
  city              String
  type              ProjectType
  startingPrice     String?     @map("starting_price")
  unitConfigSummary String?     @map("unit_config_summary")
  createdAt         DateTime    @default(now()) @map("created_at")

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  towers       Tower[]
  units        Unit[]
  media        ProjectMedia[]

  @@map("projects")
}

/// A tower/phase within a project. Cheap to model now, painful to
/// retrofit later — same reasoning as leads' attribution columns — even
/// though this slice only lets you create one inline from the Add Unit
/// dialog, not manage them separately.
model Tower {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units        Unit[]

  @@map("towers")
}

/// The sellable inventory unit. `towerId` is nullable — plotted/villa-style
/// projects may have no tower. `area` is one free-text field, not the full
/// carpet/built-up/super split from the build plan §1.1.C; that precision
/// isn't needed until someone asks for it.
model Unit {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String     @map("org_id") @db.Uuid
  projectId     String     @map("project_id") @db.Uuid
  towerId       String?    @map("tower_id") @db.Uuid
  unitNumber    String     @map("unit_number")
  configuration String?
  floor         String?
  area          String?
  price         String?
  status        UnitStatus @default(Available)
  createdAt     DateTime   @default(now()) @map("created_at")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tower        Tower?             @relation(fields: [towerId], references: [id], onDelete: SetNull)
  priceHistory UnitPriceHistory[]

  @@map("units")
}

/// A to-do, scoped tightly per docs/specs/04-tasks.md: basic CRUD plus
/// complete/reopen only — no recurrence, no notifications, no reminders.
/// Optionally linked to a lead (a follow-up call, a document to chase) via
/// leadId, or general (an org-wide chore) when leadId is null.
/// completedAt null means open; a non-null timestamp means done — there's
/// no separate "status" enum since open/done/who/when is all this slice
/// needs.
model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  leadId      String?   @map("lead_id") @db.Uuid
  title       String
  dueAt       DateTime? @map("due_at")
  assignedTo  String?   @map("assigned_to") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator      User         @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([orgId, assignedTo])
  @@index([leadId])
  @@map("tasks")
}

enum ProjectMediaType {
  brochure
  floor_plan
  price_sheet
  rera_doc
  other

  @@map("project_media_type")
}

/// Metadata only for a project's brochures / floor plans / price sheets /
/// RERA docs — see docs/specs/02-inventory.md, which previously deferred
/// this whole table pending a storage decision. `storagePath` is a plain
/// string for now (where a Supabase Storage object key/URL will eventually
/// go); wiring a real upload flow against an actual Storage bucket is still
/// deferred, tracked separately. `uploadedBy` nullable + SetNull, same
/// shape as LeadActivity.createdBy — losing the uploader's user account
/// shouldn't cascade-delete the file record itself.
model ProjectMedia {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String           @map("org_id") @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  type        ProjectMediaType
  fileName    String           @map("file_name")
  storagePath String           @map("storage_path")
  uploadedBy  String?          @map("uploaded_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader     User?        @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("project_media")
}

/// One row per price change on a unit — append-only, same shape as
/// LeadActivity/LeadAssignment above. No DB trigger: updateUnitPrice in
/// src/lib/unit-price.server.ts writes Unit.price and this row together in
/// one transaction, matching how mergeContacts does its multi-step write.
model UnitPriceHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  price     String
  changedBy String?  @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  changedByUser User?       @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@map("unit_price_history")
}

enum CallDirection {
  outbound
  inbound

  @@map("call_direction")
}

enum CallStatus {
  initiated
  ringing
  answered
  completed
  failed
  no_answer

  @@map("call_status")
}

/// Phase 4 (issue #30) — click-to-call. The real provider (Exotel/Knowlarity/
/// Twilio, common India options) is vendor-blocked pending an account; calls
/// go through the TelephonyProvider interface in src/lib/telephony/
/// provider.ts, with MockTelephonyProvider actually wired up for now (see
/// src/lib/telephony.server.ts). recordingUrl is where a real provider's
/// recording URL will land once one exists — unpopulated by the mock.
model CallLog {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  leadId          String        @map("lead_id") @db.Uuid
  direction       CallDirection
  fromNumber      String        @map("from_number")
  toNumber        String        @map("to_number")
  initiatedBy     String?       @map("initiated_by") @db.Uuid
  status          CallStatus    @default(initiated)
  durationSeconds Int?          @map("duration_seconds")
  recordingUrl    String?       @map("recording_url")
  startedAt       DateTime      @default(now()) @map("started_at")
  endedAt         DateTime?     @map("ended_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  initiator    User?        @relation(fields: [initiatedBy], references: [id], onDelete: SetNull)

  @@index([orgId, leadId])
  @@map("call_logs")
}

enum WhatsAppDirection {
  inbound
  outbound

  @@map("whatsapp_direction")
}

enum WhatsAppMessageStatus {
  queued
  sent
  delivered
  read
  failed

  @@map("whatsapp_message_status")
}

/// Phase 4 (issue #31) — WhatsApp shared inbox + templates. Same
/// vendor-blocked shape as CallLog above: no real WhatsApp Business API
/// account yet, so sends go through the WhatsAppProvider interface in
/// src/lib/whatsapp/provider.ts, with MockWhatsAppProvider actually wired up
/// for now (see src/lib/whatsapp.server.ts). Real WhatsApp Business
/// templates require platform approval, so — unlike contacts/tasks — write
/// access here is admin-gated even in this mock slice; see the RLS policies
/// in this table's migration.
model WhatsAppTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  body      String
  category  String?
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages     WhatsAppMessage[]

  @@map("whatsapp_templates")
}

/// The shared team inbox. leadId is nullable — a message can exist before
/// it's linked to a lead (an inbound message from an unknown number), though
/// in practice sendWhatsAppMessage will usually have one. Openness mirrors
/// lead_activities/call_logs: any org member can view or create, no
/// admin gate — this is routine data entry, not template management.
model WhatsAppMessage {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String                @map("org_id") @db.Uuid
  leadId     String?               @map("lead_id") @db.Uuid
  direction  WhatsAppDirection
  fromNumber String                @map("from_number")
  toNumber   String                @map("to_number")
  body       String
  templateId String?               @map("template_id") @db.Uuid
  status     WhatsAppMessageStatus @default(queued)
  createdAt  DateTime              @default(now()) @map("created_at")

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template     WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([orgId, leadId])
  @@map("whatsapp_messages")
}
