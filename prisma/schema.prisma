generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer, port 6543) — the app always talks to this
  // one at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — Prisma Migrate uses this one, since
  // migrations need session-level features pgbouncer's transaction mode
  // doesn't support. Never swap these two.
  directUrl = env("DIRECT_URL")
}

/// One row per tenant. Every tenant-scoped table's org_id points here.
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  /// Separate, unguessable, rotatable identifier for the public website
  /// lead-capture form (issue #22) — deliberately NOT id/slug. Embedded in
  /// a public form/script; holding it authorizes an anon INSERT into this
  /// org's contacts/leads only (see the RLS policies added alongside this
  /// column), never read/update/delete. Rotating it (re-running
  /// gen_random_uuid()) is how a leaked token is revoked.
  publicFormToken String @unique @default(dbgenerated("gen_random_uuid()")) @map("public_form_token") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  members          OrgMember[]
  contacts         Contact[]
  leads            Lead[]
  activities       LeadActivity[]
  assignments      LeadAssignment[]
  projects         Project[]
  towers           Tower[]
  units            Unit[]
  tasks            Task[]
  projectMedia     ProjectMedia[]
  unitPriceHistory UnitPriceHistory[]
  channelPartners   ChannelPartner[]
  bookings          Booking[]
  costSheets        CostSheet[]
  paymentMilestones PaymentMilestone[]
  demandLetters     DemandLetter[]

  @@map("organizations")
}

/// Mirrors auth.users (Supabase Auth owns real credentials). id is set to
/// the same value as auth.users.id by a trigger on signup — see the RLS/
/// setup migration, not a Prisma-managed relation, since auth.users lives
/// outside Prisma's schema.
model User {
  id        String   @id @db.Uuid
  email     String
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")

  memberships         OrgMember[]
  assignedLeads       Lead[]           @relation("LeadAssignedTo")
  authoredActivities  LeadActivity[]
  assignmentsReceived LeadAssignment[] @relation("AssignmentAssignedTo")
  assignmentsMade     LeadAssignment[] @relation("AssignmentAssignedBy")
  assignedTasks       Task[]           @relation("TaskAssignedTo")
  createdTasks        Task[]           @relation("TaskCreatedBy")
  uploadedMedia       ProjectMedia[]
  unitPriceChanges    UnitPriceHistory[]
  bookingsMade        Booking[]          @relation("BookingBookedBy")

  @@map("users")
}

enum OrgRole {
  owner
  admin
  agent
  cp_admin
  cp_agent

  @@map("org_role")
}

/// Which orgs a user belongs to, and with what role. A user can belong to
/// more than one org (e.g. a channel-partner agent working two developers),
/// so this is its own table rather than a column on User.
model OrgMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

enum LeadStatus {
  New
  FollowUp  @map("Follow Up")
  Callback
  SiteVisit @map("Site Visit")
  Booked
  Dropped

  @@map("lead_status")
}

enum ActivityType {
  note
  status_change
  call
  whatsapp
  email
  system

  @@map("activity_type")
}

/// A person, distinct from a lead — one person can be three leads across
/// three projects/sources. Merging these is "the #1 CRM schema regret"
/// per the build plan; keep them separate from day one.
model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  fullName  String   @map("full_name")
  phone     String?
  email     String?
  city      String?
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@map("contacts")
}

/// The enquiry itself. Attribution columns (source_id..captured_at) are
/// nullable and unpopulated in this slice — the ad hierarchy tables behind
/// them are Phase 3. Adding the columns now, empty, is cheap; retrofitting
/// them onto a live leads table with real data later is not (§3.5.2).
model Lead {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  contactId    String     @map("contact_id") @db.Uuid
  assignedTo   String?    @map("assigned_to") @db.Uuid
  status       LeadStatus @default(New)
  subStatus    String?    @map("sub_status")
  source       String?
  subSource    String?    @map("sub_source")
  project      String?
  budget       String?
  requirement  String?
  city         String?
  nextActionAt DateTime?  @map("next_action_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  // Attribution — §3.5.2, all nullable, unpopulated until Phase 3.
  sourceId       String?   @map("source_id") @db.Uuid
  adId           String?   @map("ad_id") @db.Uuid
  adSetId        String?   @map("ad_set_id") @db.Uuid
  campaignId     String?   @map("campaign_id") @db.Uuid
  creativeId     String?   @map("creative_id")
  formId         String?   @map("form_id")
  platformLeadId String?   @map("platform_lead_id")
  clickId        String?   @map("click_id")
  utmSource      String?   @map("utm_source")
  utmMedium      String?   @map("utm_medium")
  utmCampaign    String?   @map("utm_campaign")
  utmContent     String?   @map("utm_content")
  utmTerm        String?   @map("utm_term")
  landingPageUrl String?   @map("landing_page_url")
  referrerUrl    String?   @map("referrer_url")
  firstTouchAdId String?   @map("first_touch_ad_id") @db.Uuid
  rawPayload     Json?     @map("raw_payload")
  capturedAt     DateTime? @map("captured_at")

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee     User?            @relation("LeadAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  activities   LeadActivity[]
  assignments  LeadAssignment[]
  tasks        Task[]
  bookings     Booking[]

  @@map("leads")
}

/// The timeline. One table across activity types rather than one per type,
/// matching the existing UI's "History" tab.
model LeadActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  leadId    String       @map("lead_id") @db.Uuid
  type      ActivityType
  body      String
  createdBy String?      @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("lead_activities")
}

/// History, not a column — "who had this lead in March" needs to be
/// answerable in a brokerage dispute, per the build plan.
model LeadAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  assignedTo String   @map("assigned_to") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee       User         @relation("AssignmentAssignedTo", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedByUser User?        @relation("AssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@map("lead_assignments")
}

enum ProjectType {
  Residential
  Commercial
  Agricultural

  @@map("project_type")
}

enum UnitStatus {
  Available
  Blocked
  Booked
  Registered

  @@map("unit_status")
}

/// A developer/builder project. See docs/specs/02-inventory.md — no
/// separate `developers` entity yet; `Organization` is the tenant boundary
/// and there's no current product need to model multiple developers under
/// one org. starting_price / unit_config_summary are display-only free
/// text (matches the pre-existing mock UI), not derived from real units.
model Project {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String      @map("org_id") @db.Uuid
  name              String
  city              String
  type              ProjectType
  startingPrice     String?     @map("starting_price")
  unitConfigSummary String?     @map("unit_config_summary")
  createdAt         DateTime    @default(now()) @map("created_at")

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  towers       Tower[]
  units        Unit[]
  media        ProjectMedia[]

  @@map("projects")
}

/// A tower/phase within a project. Cheap to model now, painful to
/// retrofit later — same reasoning as leads' attribution columns — even
/// though this slice only lets you create one inline from the Add Unit
/// dialog, not manage them separately.
model Tower {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units        Unit[]

  @@map("towers")
}

/// The sellable inventory unit. `towerId` is nullable — plotted/villa-style
/// projects may have no tower. `area` is one free-text field, not the full
/// carpet/built-up/super split from the build plan §1.1.C; that precision
/// isn't needed until someone asks for it.
model Unit {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String     @map("org_id") @db.Uuid
  projectId     String     @map("project_id") @db.Uuid
  towerId       String?    @map("tower_id") @db.Uuid
  unitNumber    String     @map("unit_number")
  configuration String?
  floor         String?
  area          String?
  price         String?
  status        UnitStatus @default(Available)
  createdAt     DateTime   @default(now()) @map("created_at")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tower        Tower?             @relation(fields: [towerId], references: [id], onDelete: SetNull)
  priceHistory UnitPriceHistory[]
  bookings     Booking[]

  @@map("units")
}

/// A to-do, scoped tightly per docs/specs/04-tasks.md: basic CRUD plus
/// complete/reopen only — no recurrence, no notifications, no reminders.
/// Optionally linked to a lead (a follow-up call, a document to chase) via
/// leadId, or general (an org-wide chore) when leadId is null.
/// completedAt null means open; a non-null timestamp means done — there's
/// no separate "status" enum since open/done/who/when is all this slice
/// needs.
model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  leadId      String?   @map("lead_id") @db.Uuid
  title       String
  dueAt       DateTime? @map("due_at")
  assignedTo  String?   @map("assigned_to") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator      User         @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([orgId, assignedTo])
  @@index([leadId])
  @@map("tasks")
}

enum ProjectMediaType {
  brochure
  floor_plan
  price_sheet
  rera_doc
  other

  @@map("project_media_type")
}

/// Metadata only for a project's brochures / floor plans / price sheets /
/// RERA docs — see docs/specs/02-inventory.md, which previously deferred
/// this whole table pending a storage decision. `storagePath` is a plain
/// string for now (where a Supabase Storage object key/URL will eventually
/// go); wiring a real upload flow against an actual Storage bucket is still
/// deferred, tracked separately. `uploadedBy` nullable + SetNull, same
/// shape as LeadActivity.createdBy — losing the uploader's user account
/// shouldn't cascade-delete the file record itself.
model ProjectMedia {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String           @map("org_id") @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  type        ProjectMediaType
  fileName    String           @map("file_name")
  storagePath String           @map("storage_path")
  uploadedBy  String?          @map("uploaded_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader     User?        @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("project_media")
}

/// One row per price change on a unit — append-only, same shape as
/// LeadActivity/LeadAssignment above. No DB trigger: updateUnitPrice in
/// src/lib/unit-price.server.ts writes Unit.price and this row together in
/// one transaction, matching how mergeContacts does its multi-step write.
model UnitPriceHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  price     String
  changedBy String?  @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  changedByUser User?       @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@map("unit_price_history")
}

// ============================================================================
// Phase 5 — booking flow, cost sheet, payment schedule, demand letters,
// channel partners. See docs/specs/06-booking.md. All five are org-scoped,
// RLS enabled from the migration that creates them (CLAUDE.md). Money
// columns use Decimal, not Unit.price's free-text String style, because
// this slice actually does arithmetic on them (cost sheet totals, payment
// balances) — String would just push that parsing into application code.
// ============================================================================

enum BookingStatus {
  draft
  confirmed
  cancelled

  @@map("booking_status")
}

enum PaymentMilestoneStatus {
  pending
  paid
  overdue

  @@map("payment_milestone_status")
}

enum DemandLetterStatus {
  draft
  sent

  @@map("demand_letter_status")
}

/// A brokerage/channel-partner firm that can be attributed to a booking for
/// commission purposes. commissionPercent is nullable — not every booking
/// goes through a CP. No update/delete server function in this slice (only
/// createChannelPartner/listChannelPartners are asked for); add later if
/// there's a real need to edit or remove one.
model ChannelPartner {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  name              String
  contactPhone      String?  @map("contact_phone")
  contactEmail      String?  @map("contact_email")
  commissionPercent Decimal? @map("commission_percent") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@map("channel_partners")
}

/// The sale itself — links a Lead to a Unit. createBooking (src/lib/
/// booking.server.ts) creates this with status `confirmed` directly and, in
/// the same transaction, flips the Unit to `Booked` and logs a system
/// LeadActivity — same transactional shape as updateUnitPrice
/// (src/lib/unit-price.server.ts) and mergeContacts (src/lib/dedup.server.ts).
/// bookedBy/channelPartnerId are both nullable + SetNull: losing the agent's
/// account or the CP record shouldn't take the booking down with it.
model Booking {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  leadId           String        @map("lead_id") @db.Uuid
  unitId           String        @map("unit_id") @db.Uuid
  bookedBy         String?       @map("booked_by") @db.Uuid
  channelPartnerId String?       @map("channel_partner_id") @db.Uuid
  bookingDate      DateTime      @default(now()) @map("booking_date")
  totalPrice       Decimal       @map("total_price") @db.Decimal(14, 2)
  status           BookingStatus @default(draft)
  createdAt        DateTime      @default(now()) @map("created_at")

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead              Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unit              Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bookedByUser      User?              @relation("BookingBookedBy", fields: [bookedBy], references: [id], onDelete: SetNull)
  channelPartner    ChannelPartner?    @relation(fields: [channelPartnerId], references: [id], onDelete: SetNull)
  costSheet         CostSheet?
  paymentMilestones PaymentMilestone[]
  demandLetters     DemandLetter[]

  @@map("bookings")
}

/// One cost sheet per booking (enforced by the @unique on bookingId).
/// otherCharges stays a flexible Json bag (e.g. { floorRise, parking, gst })
/// rather than a hardcoded column per charge type — same "don't model every
/// variant until asked" reasoning as Project.startingPrice. totalAmount is
/// computed server-side in createCostSheet (basePrice + sum of otherCharges'
/// numeric values), not a generated column, so the math stays visible and
/// simple in application code.
model CostSheet {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  bookingId    String   @unique @map("booking_id") @db.Uuid
  basePrice    Decimal  @map("base_price") @db.Decimal(14, 2)
  otherCharges Json?    @map("other_charges")
  totalAmount  Decimal  @map("total_amount") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("cost_sheets")
}

/// One row per installment in a booking's payment plan. generatePaymentSchedule
/// bulk-creates these; recordPayment updates paidAmount/paidAt/status on one.
/// status is a plain enum, not derived from paidAmount vs. dueAmount at read
/// time, because `overdue` also depends on dueDate vs. "now" — something no
/// current server function computes (this slice never sets it; a background
/// sweep is a follow-up, and CLAUDE.md says not to reach for one prematurely).
model PaymentMilestone {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String                  @map("org_id") @db.Uuid
  bookingId   String                  @map("booking_id") @db.Uuid
  label       String
  dueAmount   Decimal                 @map("due_amount") @db.Decimal(14, 2)
  dueDate     DateTime?               @map("due_date")
  paidAmount  Decimal                 @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paidAt      DateTime?               @map("paid_at")
  status      PaymentMilestoneStatus  @default(pending)
  createdAt   DateTime                @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  demandLetters DemandLetter[]

  @@index([orgId, bookingId])
  @@map("payment_milestones")
}

/// Generated demand-letter text for one milestone on one booking. `content`
/// is plain readable text/markdown built by string interpolation in
/// generateDemandLetter (src/lib/booking.server.ts) — real PDF rendering is
/// a deferred integration, no library added here per CLAUDE.md ("ask before
/// adding new dependencies"). milestoneId is nullable + SetNull so a demand
/// letter isn't destroyed if its milestone is ever removed.
model DemandLetter {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String              @map("org_id") @db.Uuid
  bookingId   String              @map("booking_id") @db.Uuid
  milestoneId String?             @map("milestone_id") @db.Uuid
  content     String
  amount      Decimal             @db.Decimal(14, 2)
  status      DemandLetterStatus  @default(draft)
  generatedAt DateTime            @default(now()) @map("generated_at")

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  milestone    PaymentMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([orgId, bookingId])
  @@map("demand_letters")
}
